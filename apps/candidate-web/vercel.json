{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://REPLACE_WITH_API_DOMAIN/v1/:path*" },
    { "source": "/v2/:path*", "destination": "https://REPLACE_WITH_API_DOMAIN/v2/:path*" },
    { "source": "/health", "destination": "https://REPLACE_WITH_API_DOMAIN/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
