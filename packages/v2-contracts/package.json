{
  "name": "@cpf/v2-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CPF V2 immutable domain/API/event/manifest contracts (S05). Zod source of truth; versioned; unknown fields rejected at security-sensitive boundaries; UTC everywhere.",
  "exports": {
