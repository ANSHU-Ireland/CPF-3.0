{
  "name": "@cpf/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CPF V2 design system (S04): semantic tokens and accessible React primitives. Calm, precise, humane — no surveillance theatre, no colour-only status, WCAG 2.2 AA targets.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "files": [
    "dist",
    "tokens.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0",
    "axe-core": "^4.12.1"
  }
}
